{
  "name": "electron-client",
  "private": true,
  "version": "1.0.0",
  "author": "Ragul",
  "description": "RemoteAssist Application",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:exe": "npm run build && electron-builder",
    "publish:exe": "npm run build && electron-builder -p always",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.remoteassist.app",
    "productName": "RemoteAssist",
    "protocols": {
      "name": "RemoteAssist Protocol",
      "schemes": [
        "remoteassist"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "Ragul-008",
      "repo": "remote_assist"
    },
    "directories": {
      "output": "release-new"
    },
    "asar": true,
    "asarUnpack": [
      "**/@nut-tree-fork/**"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "axios": "^1.18.1",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
